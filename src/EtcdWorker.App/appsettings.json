{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "EtcdWorker": {
    "Etcd": {
      "Endpoints": []
    },
    "Docker": {
      "Mode": "Plain",
      "Hosts": [],
      "Network": "etcdw-net",
      "PortRange": { "From": 18100, "To": 18199 },
      "Images": { "EtcdNode": "pgworker/etcdnode:dev" },
      "AdvertisedHost": null
    },
    "NodeSnapshot": {
      "RetentionFiles": 10,
      "IntervalMin": 360,
      "MinIntervalSec": 300,
      "MaintenanceIntervalMin": 60,
      "RetentionObjects": 28,
      "RetryIntervalSec": 300,
      "TimeoutSec": 30,
      "S3": { "CaBundlePath": null }
    },
    "Thresholds": {
      "NodeBootSec": 100,
      "NodeDeadSec": 300,
      "HealthIntervalSec": 15
    },
    "Loops": {
      "ScanIntervalSec": 5,
      "KeepaliveSec": 5,
      "ErrorDelayMs": 2000,
      "Watchdog": { "Enabled": true, "Multiplier": 2, "CheckIntervalSec": 15 }
    },
    "Api": {
      "AdvertiseUrl": "",
      "Tls": {}
    },
    "Metrics": { "Enabled": true }
  }
}
