{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ValkeyWorker": {
    "Etcd": {
      "Endpoints": [ "http://localhost:2379" ]
    },
    "Metrics": { "Enabled": true, "Path": "/metrics" },
    "Docker": {
      "Mode": "Plain",
      "Hosts": [
        { "Name": "local", "Endpoint": "unix:///var/run/docker.sock" }
      ],
      "SwarmManager": null,
      "PortRange": { "From": 17000, "To": 17999 },
      "Images": { "Node": "valkey/valkey:9.1.2" }
    },
    "Loops": {
      "ScanIntervalSec": 5,
      "KeepaliveSec": 5,
      "ErrorDelayMs": 2000,
      "SnapshotIntervalMin": 360
    },
    "Thresholds": {
      "NodeBootSec": 120,
      "NodeDeadSec": 90
    },
    "Parallelism": { "MaxClusters": 4 },
    "Snapshots": { "Dir": "/snapshots", "RetentionFiles": 10, "MaintenanceIntervalMin": 60 },
    "AdvertisedClientHost": null,
    "Api": { "AdvertiseUrl": "", "EnableSeedEndpoint": false }
  }
}
