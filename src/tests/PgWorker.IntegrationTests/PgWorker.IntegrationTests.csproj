<Project Sdk="Microsoft.NET.Sdk">

    <!-- E2E-классы изолированы каноном (guid-контуры, own-only teardown) —
         коллекции гоняются параллельно (max 5 контуров одновременно: пул
         docker ~30 user-сетей, движковая сеть нод одна на всех — 5 env-сетей
         держат запас; контроль docker network ls в прогонах серий);
         «тихие» классы с общими ассетами при конфликте — в [Collection]-группу.
         Канон AGENTS.md «E2E-образы/E2E-изоляция». -->
    <PropertyGroup>
        <XunitParallelizeTestCollections>true</XunitParallelizeTestCollections>
        <XunitMaxParallelThreads>5</XunitMaxParallelThreads>
        <XunitParallelizeAssembly>false</XunitParallelizeAssembly>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="FluentAssertions"/>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="FluentAssertions"/>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="Npgsql"/>
        <PackageReference Include="Testcontainers"/>
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\PgWorker.Core\PgWorker.Core.csproj"/>
        <ProjectReference Include="..\..\PgWorker.Etcd\PgWorker.Etcd.csproj"/>
        <ProjectReference Include="..\..\PgWorker.Docker\PgWorker.Docker.csproj"/>
        <ProjectReference Include="..\..\PgWorker.Provisioning\PgWorker.Provisioning.csproj"/>
        <ProjectReference Include="..\..\PgWorker.Moves\PgWorker.Moves.csproj"/>
        <ProjectReference Include="..\..\PgWorker.Backups\PgWorker.Backups.csproj"/>
        <ProjectReference Include="..\..\PgWorker.WalReceiver\PgWorker.WalReceiver.csproj"/>
        <ProjectReference Include="..\..\PgWorker.App\PgWorker.App.csproj"/>
        <!-- t04: E2E-ассерт «панельный парсер читает без parseErrors» (Assert 3 маркера). -->
        <ProjectReference Include="..\..\AdminPanel.Etcd\AdminPanel.Etcd.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Shared.Core"/>
        <Using Include="Shared.Core.Planning"/>
        <Using Include="Shared.Docker"/>
        <Using Include="Shared.Etcd.Coordination"/>
    </ItemGroup>

</Project>
