{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "S3Worker": {
    "Etcd": {
      "Endpoints": [ "http://localhost:2379" ]
    },
    "Bucket": "",
    "Docker": {
      "Mode": "Plain",
      "Hosts": [
        { "Name": "local", "Endpoint": "unix:///var/run/docker.sock" }
      ],
      "SwarmManager": null,
      "PortRange": { "From": 18000, "To": 18999 },
      "Images": { "OwnS3": "owns3:dev" },
      "ContourNetwork": null,
      "AdvertisedHost": null
    },
    "Loops": {
      "ScanIntervalSec": 5,
      "KeepaliveSec": 5,
      "ErrorDelayMs": 2000,
      "SnapshotIntervalMin": 360,
      "Watchdog": { "Enabled": true, "Multiplier": 2, "CheckIntervalSec": 15, "StopDelaySec": 1 }
    },
    "Thresholds": {
      "NodeBootSec": 100,
      "NodeDeadSec": 90,
      "HealthIntervalSec": 15
    },
    "Parallelism": { "MaxClusters": 4 },
    "Snapshots": { "Dir": "/snapshots", "RetentionFiles": 10, "MaintenanceIntervalMin": 60 },
    "Api": { "AdvertiseUrl": "", "EnableSeedEndpoint": false }
  }
}
