<Project Sdk="Microsoft.NET.Sdk.Worker">

    <!-- Приёмник WAL (t25, arch/19 §3): WebApplication (Kestrel :8080 — только
         /metrics) + hosted-цикл стрима (WalReceiverLoop); репликация Npgsql +
         доставка сегментов в S3 (IBackupS3 из Backups). Приёмник живёт ВНУТРИ
         контейнера PG-ноды (supervisord-программа walreceiver, self-contained
         publish — см. docker/node/Dockerfile); отдельного образа pgworker-wal
         больше нет. -->
    <PropertyGroup>
        <!-- Имя бинаря self-contained publish — /opt/pgw-wal/walreceiver. -->
        <AssemblyName>walreceiver</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="PgWorker.UnitTests"/>
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PgWorker.Backups\PgWorker.Backups.csproj"/>
        <!-- Метрики приёмника: AddAppMetrics/MapAppMetrics (arch/18 §1/§2.8). -->
        <ProjectReference Include="..\Shared.Metrics\Shared.Metrics.csproj"/>
    </ItemGroup>
</Project>
