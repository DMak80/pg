{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AdminPanel": {
    "Auth": {
      "Username": "admin"
    },
    "Metrics": { "Enabled": true, "Path": "/metrics" },
    "Etcd": {
      "Endpoints": [],
      "RefreshIntervalSeconds": 3,
      "RequestTimeoutSeconds": 2
    },
    "Alerts": {
      "StaleMoveSeconds": 600,
      "FrozenSeconds": 60,
      "ReplicaLagBytes": 16777216,
      "SlotSafeWalSizeBytes": 1073741824,
      "NotInitializedWarnSec": 900,
      "ProvisionStuckSec": 300
    },
    "Workers": {
      "HealthEnabled": true,
      "HealthIntervalSec": 15
    },
    "Probes": {
      "PatroniEnabled": true,
      "SqlEnabled": true,
      "IntervalSeconds": 15,
      "TimeoutSeconds": 3,
      "Password": "",
      "HostMap": {}
    }
  }
}
