{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AdminPanel": {
    "Auth": {
      "Username": "admin"
    },
    "Etcd": {
      "Endpoints": [],
      "RefreshIntervalSeconds": 3,
      "RequestTimeoutSeconds": 2
    },
    "Alerts": {
      "StaleMoveSeconds": 600,
      "FrozenSeconds": 60,
      "ReplicaLagBytes": 16777216,
      "SlotSafeWalSizeBytes": 1073741824
    },
    "Probes": {
      "PatroniEnabled": true,
      "SqlEnabled": true,
      "IntervalSeconds": 15,
      "TimeoutSeconds": 3,
      "Password": "",
      "HostMap": {}
    }
  }
}
