<Project Sdk="Microsoft.NET.Sdk.Worker">

    <!-- Агент PgNode (t25/t05, arch/backups/02-wal-archive.md §1, arch/pgworker/01-placement.md §1): WebApplication (Kestrel :8080 — только
         /metrics) + hosted-цикл стрима (WalReceiverLoop); репликация Npgsql +
         доставка сегментов в S3 (IBackupS3 из Backups). Приёмник живёт ВНУТРИ
         контейнера PG-ноды (supervisord-программа pgnode, self-contained
         publish — см. docker/node/Dockerfile); отдельного образа pgworker-wal
         больше нет. -->
    <PropertyGroup>
        <!-- Имя бинаря self-contained publish — /opt/pgw-node/pgnode. -->
        <AssemblyName>pgnode</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="PgWorker.UnitTests"/>
        <!-- WebApplicationFactory<Program> API-тестов маршрутов (шаг 9):
             доступ к internal-Program (прецедент KafkaWorker.App.csproj). -->
        <InternalsVisibleTo Include="PgWorker.IntegrationTests"/>
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PgWorker.Backups\PgWorker.Backups.csproj"/>
        <!-- Метрики приёмника: AddAppMetrics/MapAppMetrics (arch/metrics/01-framework.md §1/§2.8). -->
        <ProjectReference Include="..\Shared.Metrics\Shared.Metrics.csproj"/>
        <!-- Валидация цепочки клиентских сертов mTLS-канала :8081 (arch/pg-clusters/13-network-security.md §2). -->
        <ProjectReference Include="..\Shared.Tls\Shared.Tls.csproj"/>
    </ItemGroup>
</Project>
