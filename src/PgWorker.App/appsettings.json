{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "PgWorker": {
    "Etcd": {
      "Endpoints": [ "http://localhost:2379" ]
    },
    "Docker": {
      "Mode": "Plain",
      "Hosts": [
        { "Name": "local", "Endpoint": "unix:///var/run/docker.sock" }
      ],
      "SwarmManager": null,
      "PortRange": { "From": 15000, "To": 16000 },
      "Images": { "Node": "pgworker-node:dev" },
      "EnableDoorman": true
    },
    "Loops": {
      "ScanIntervalSec": 5,
      "KeepaliveSec": 5,
      "SnapshotIntervalMin": 360,
      "ErrorDelayMs": 2000
    },
    "Thresholds": {
      "NodeDeadSec": 90,
      "ShardDeadSec": 300,
      "PatroniBootSec": 600,
      "CutoverTimeoutSec": 90,
      "ConnFailBudgetSec": 120
    },
    "Parallelism": { "MaxClusters": 4 },
    "Snapshots": { "Dir": "/snapshots", "RetentionFiles": 10 },
    "Moves": {
      "PollIntervalSec": 2,
      "FreezeWaitSec": 5,
      "FreezeLockTimeoutSec": 5,
      "FreezeLockTries": 3,
      "AbortMinAgeSec": 120,
      "FailoverSlots": true,
      "AdvertisedPublisherHost": "host.docker.internal"
    },
    "AppParams": { "Default": "sslmode=require" },
    "Api": { "AdvertiseUrl": "", "EnableSeedEndpoint": false }
  }
}
