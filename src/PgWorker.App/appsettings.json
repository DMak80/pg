{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "PgWorker": {
    "Etcd": {
      "Endpoints": [ "http://localhost:2379" ]
    },
    "Metrics": { "Enabled": true, "Path": "/metrics" },
    "Docker": {
      "Mode": "Plain",
      "Hosts": [
        { "Name": "local", "Endpoint": "unix:///var/run/docker.sock" }
      ],
      "SwarmManager": null,
      "PortRange": { "From": 15000, "To": 16000 },
      "Images": { "Node": "pgworker-node:dev" },
      "EnableDoorman": true,
      "AdvertisedHost": null,
      "Tls": null,
      "Ssh": null
    },
    "Loops": {
      "ScanIntervalSec": 5,
      "KeepaliveSec": 5,
      "SnapshotIntervalMin": 360,
      "ErrorDelayMs": 2000
    },
    "Thresholds": {
      "NodeDeadSec": 90,
      "ShardDeadSec": 300,
      "PatroniBootSec": 600,
      "CutoverTimeoutSec": 90,
      "ConnFailBudgetSec": 120,
      "ProvisionRetryBaseSec": 5,
      "ProvisionRetryMaxSec": 60
    },
    "Parallelism": { "MaxClusters": 4 },
    "Snapshots": { "Dir": "/snapshots", "RetentionFiles": 10 },
    "Moves": {
      "PollIntervalSec": 2,
      "FreezeWaitSec": 5,
      "FreezeLockTimeoutSec": 5,
      "FreezeLockTries": 3,
      "AbortMinAgeSec": 120,
      "FailoverSlots": true,
      "AdvertisedPublisherHost": "host.docker.internal",
      "RepairStaleSec": 600,
      "RepairFrozenSec": 120
    },
    "AppParams": { "Default": "sslmode=require" },
    "Api": {
      "AdvertiseUrl": "",
      "EnableSeedEndpoint": false,
      "Tls": { "AllowInsecureHttp": false }
    },
    "Backups": {
      "Enabled": false,
      "AgentImage": "pgworker-backup:latest",
      "Wal": {
        "VerifyIntervalSec": 30,
        "LagMaxSegments": 1024,
        "StaleSec": 300
      },
      "Retention": { "IntervalSec": 600, "KeepFailed": 20 },
      "Quota": { "Bytes": 0, "WarnPercent": 80, "CritPercent": 90 }
    }
  }
}
