# deploy/etcd/etcd.env.example — env SEED-узла etcd-контура (arch/etcdworker/06-operability.md §7 п.5,
# arch/etcdworker/README.md). Один узел: состав доводит EtcdWorker; после доводки seed
# выводится (runbook). Образ — из локального registry (arch/operations/02-registry-images.md).
NODE_NAME=etcd-seed
ETCD_IMAGE=192.168.0.1:5000/quay.io/coreos/etcd:v3.5.21
CLUSTER_TOKEN=pgworker-controlplane-2026
DATA_DIR=/data/etcd-seed

# bootstrap-флаг: seed всегда new (единственный узел initial-cluster);
# INITIAL_CLUSTER_STATE=existing — управляемые узлы ставит EtcdWorker.
INITIAL_CLUSTER_STATE=new
