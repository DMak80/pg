# Секреты установки PgWorker (arch/14 Д7): per-install, в git НЕ попадают
# (deploy/.env в .gitignore). Для локального dev-стенда скопируй и меняй:
#   cp deploy/.env.example deploy/.env
# 00-up.sh делает это сам, если файла нет (dev-значения ниже).
PGW_PG_SUPERUSER_PASSWORD=pgw-local-superuser
PGW_PG_STANDBY_PASSWORD=pgw-local-standby
# Fallback ДО ensure per-cluster секретов (t02): канон — etcd-ключи кластера
# /clusters/<C>/{bucket_admin_user,bucket_admin_password,mover_password} (arch/14 §5 I),
# их генерирует ClusterSecretEnsurer при provisioning; env-значения читаются,
# пока ключей ещё нет (кластеры, поднятые до t02, без ensure).
PGW_BUCKET_ADMIN_PASSWORD=pgw-local-bucket-admin
PGW_BUCKET_MOVER_PASSWORD=pgw-local-bucket-mover

# etcd-контур контроль-плейна (t09, arch/04 §8): СПИСОК всех клиентских URL
# трёх узлов. Стендовые дефолты — публикации as-etcd-1/2/3 (2379/2381/2383).
# ПРОД: адреса трёх узлов контура deploy/etcd (arch/04 §8); допустимы 1–2
# узла (не-HA прогон) — failover клиентов перебирает список.
PGW_ETCD_ENDPOINT_0=http://host.docker.internal:2379
PGW_ETCD_ENDPOINT_1=http://host.docker.internal:2381
PGW_ETCD_ENDPOINT_2=http://host.docker.internal:2383
# KafkaWorker/ValkeyWorker — тот же контур (симметрично; дефолты compose).
KFW_ETCD_ENDPOINT_0=http://host.docker.internal:2379
KFW_ETCD_ENDPOINT_1=http://host.docker.internal:2381
KFW_ETCD_ENDPOINT_2=http://host.docker.internal:2383
VWK_ETCD_ENDPOINT_0=http://host.docker.internal:2379
VWK_ETCD_ENDPOINT_1=http://host.docker.internal:2381
VWK_ETCD_ENDPOINT_2=http://host.docker.internal:2383

# Advertised-имя docker-хоста в portalloc/dsn (advertised-правило arch/16,
# симметрия KFW_ADVERTISED_CLIENT_HOST): адреса нод в etcd резолвимы клиентами
# (панель пробирует host.docker.internal:15xxx/18xxx). Пусто (прод/мульти-хост,
# имена хостов резолвимы сами) → имя docker-хоста как есть.
PGW_ADVERTISED_HOST=host.docker.internal

# Единая сеть контура мониторинга: на стенде = стендовая сеть контура
# (отдельная pgw-metrics НЕ создаётся — весь стенд в одной сети; t41);
# прод — владелец deploy (pgw-metrics), стендовый Prometheus — external.
PGW_METRICS_NETWORK=adminpanel-stand-net
PGW_SCRAPE_NETWORK=adminpanel-stand-net

# Сеть контура поставки (t41, arch/14 §2.1): имя внешней сети, в которой
# живут ВСЕ контейнеры контура (стенд — adminpanel-stand-net, владелец —
# стендовый compose; deploy подключается external через
# docker-compose.contour.yml; METRICS-ключи выше — то же имя). ПРОД:
# закомментировать — пусто = per-cluster pgw-net-<C> (канон arch/14),
# METRICS-ключи вернуть на pgw-metrics.
PGW_CONTOUR_NETWORK=adminpanel-stand-net

# HTTP API воркеров (arch/14 §1.1 / arch/16 §1.1): AdvertiseUrl публикуется
# lease-ключом /pgworker/api/<id> (/kafkaworker/api/<id>) — панель резолвит
# API воркеров только по нему. Стендовые значения: pgw — хост-публикация 8080,
# kfw — 8081. ПРОД: сид выключить (false).
# mTLS HTTP API воркеров (t03, arch/14 §1.1/arch/16 §1.1): per-install пакет
# `bash deploy/tls/gen.sh` (ca.pem, server.*/pgserver.*, panel/seed/*).
# Наполнение deploy-тома pgw-api-tls включает и ca.key — ключ
# выпуска серверных сертов REST-эндпоинтов нод (t22, arch/14 §4 гр.3/§9 R16:
# воркер выпускает серты из per-install CA; env PGW_REST_TLS_CA_PATH/
# PGW_REST_TLS_CA_KEY_PATH задаются deploy-compose на оба инстанса).
# Стендовые compose монтируют каталог/volume с пакетом; здесь
# настраивается только advertise (https). Альтернатива путям — PEM-значения
# PGW_API_TLS_{CERT,KEY,CLIENT_CA} (без _PATH).
# Прод-транспорт к Engine API (arch/14 §2.2.1): tcp://:2376+mTLS (пакет
# `bash deploy/tls/gen-docker.sh <host>`: PGW_DOCKER_TLS_{CA,CERT,KEY}_PATH)
# или ssh://user@host (PGW_DOCKER_SSH_KEY[_PATH], опц. PGW_DOCKER_SSH_FINGERPRINT).
# Хост-публикация API pgworker (коллизии портов на хосте; канон 8080);
# advertise по умолчанию следует за публикацией (compose-дефолт) — задавайте
# PGW_API_ADVERTISE_URL только при нестандартном имени хоста.
# PGW_API_HOST_PORT=8080
# Вторые инстансы воркеров (t07, arch/14 §2 / arch/16 §2.1 / arch/21 §2): по
# два контейнера каждого воркера ВСЕГДА (SPOF надзора устранён дефолтом).
# Хост-порты вторых — продолжение ряда 8080/8081/8082; advertise вторых
# инстансов следует за их портами автоматически (compose-дефолт) — отдельная
# advertise-env не нужна.
# PGW_API_HOST_PORT2=8083
# KFW_API_HOST_PORT2=8084
# VWK_API_HOST_PORT2=8085
PGW_API_ENABLE_SEED=true
# KafkaWorker — HTTPS-грань, mTLS только на /api (t03, arch/16 §1.1): AdvertiseUrl https://;
# per-install TLS-пакет генерируется `bash deploy/tls/gen.sh` (ca.pem,
# server.crt/key, panel.crt/key, seed.crt/key — вне git). Стендовый
# 00-up.sh сам генерирует пакет и наполняет volume kfw-api-tls; панель
# получает panel.crt/key + ca.pem через env WORKERS_PANEL_TLS_*_PATH.
KFW_API_ADVERTISE_URL=https://host.docker.internal:8081
KFW_API_ENABLE_SEED=true

# Подсистема бэкапов шардов (arch/19): пул S3 per-cluster — policy кластера
# ссылается пул /s3/clusters/ (выбор пула и списков записи — панель, модал
# «Пул бэкапов»); креды пула — per-cluster в etcd (/s3/clusters/<C>/secrets,
# воркер читает сам). Здесь только per-install константа: bucket.
PGW_BACKUPS_ENABLED=true
PGW_BACKUP_S3_BUCKET=pgworker-backups
# Доверие CA при https S3-целях (arch/19 §7): путь ca.pem ВНУТРИ контейнера
# воркера (ro-монтирование TLS-пакета установки, /tls/ca.pem); единый на все
# цели всех пулов. S3-клиенты (воркер/приёмники) — доверие из CaBundlePath/
# PEM; tool-операции получают PEM в POST-команде.
# Стенд (http-цели) — не задавать.
#PGW_BACKUP_S3_CA_BUNDLE_PATH=/tls/ca.pem

# Слепки etcd — ОТДЕЛЬНАЯ env-пара (arch/14 §6/§8): ЗАПЯТАЯ-СПИСОК адресов
# существующих owns3-нод (перебор до первого живого — отказ ноды не
# останавливает выкладку слепков; одиночный адрес — частный случай), СВОЙ
# bucket (префикс etcd/), свои креды (одни на все цели); обязательна при
# PGW_SNAPSHOTS_EXPORT_ENABLED=true (fail-fast старта), PGW_BACKUP_S3_*
# не переиспользует.
#PGW_SNAPSHOTS_S3_ENDPOINTS=http://owns3:9000,http://owns3-2:9000
#PGW_SNAPSHOTS_S3_BUCKET=pgworker-etcd-snapshots
#PGW_SNAPSHOTS_S3_ACCESS_KEY=pgw-backups-writer
#PGW_SNAPSHOTS_S3_SECRET_KEY=pgw-backups-writer-pwd
PGW_SNAPSHOTS_EXPORT_ENABLED=false

# PGTune-параметры PG-нод (PgWorker:Pgtune, arch/14 §2.1/§8): postgresql.conf
# нод рассчитывается PGTune при СОЗДАНИИ контейнера (provision/rebuild/надзор).
# Память/CPU — НЕ здесь и НЕ в appsettings: их источник — etcd-заявки
# /service/<scope>/request_{cpu,mem} на ноду (панель пишет при создании
# шарда; arch/14 §2.1 п.4). Работающие ноды не переконфигурируются
# (конвергенция — t11 roadmap); doorman-бюджет синхронизирован:
# max(10, Connections − 5). Всё закомментировано = дефолты appsettings;
# DbType=desktop запрещён валидацией старта (wal_level=minimal несовместим
# с P3). ExcludeParams — параметры, не применяемые в YAML (env-массив
# задаётся ЦЕЛИКОМ: __0/__1); io_method/io_workers выключены, пока не
# проверена сборка Spilo с liburing (после проверки — уберите из exclude).
#PGW_PGTUNE_DB_VERSION=18
#PGW_PGTUNE_DB_TYPE=oltp
#PGW_PGTUNE_HD_TYPE=ssd
#PGW_PGTUNE_DB_SIZE=mid_ram
#PGW_PGTUNE_CONNECTIONS=60
#PGW_PGTUNE_EXCLUDE_0=io_method
#PGW_PGTUNE_EXCLUDE_1=io_workers

# ownS3 (arch/owns3/05) — standalone-хранилище стенда: root-пара обязательна
# (fail-fast старта); статические ключи (ниже) обслуживают слепки etcd
# (PGW_SNAPSHOTS_S3_*; ключ 0 — writer, ключ 1 — read-only). Креды кластеров
# /s3/ (S3Worker) и пулов бэкапов PgWorker — per-cluster в etcd
# (/s3/clusters/<C>/secrets), сюда не входят. Значения ниже — стендовые
# примеры (прод — per-install секрет). as-minio полного стенда — переходный
# read-only-архив: новых объектов не получает, снос по критерию
# docs/owns3-migration.md.
OWNS3_ROOT_USER=owns3-local-root
OWNS3_ROOT_PASSWORD=owns3-local-root-pwd
#OWNS3_HOST_PORT=9010
OWNS3_ACCESS_KEYS__0__ACCESSKEY=pgw-backups-writer
OWNS3_ACCESS_KEYS__0__SECRETKEY=pgw-backups-writer-pwd
OWNS3_ACCESS_KEYS__0__POLICY=read-write
OWNS3_ACCESS_KEYS__1__ACCESSKEY=panel-reader
OWNS3_ACCESS_KEYS__1__SECRETKEY=panel-reader-pwd
OWNS3_ACCESS_KEYS__1__POLICY=read-only
# ownS3 XL Erasure (arch/owns3/06 §1): профиль owns3-ec compose
# (4 тома 3+1, тот же образ); хост-порт — продолжение ряда ownS3.
#OWNS3_EC_HOST_PORT=9011
# TLS-опция прод-инсталляции (arch/owns3/05 §4/§6): серт owns3 выпускает
# `bash deploy/tls/gen.sh`; сервис compose owns3 монтирует TLS-каталог ro и
# получает OWNS3_TLS_CERT_PATH/_KEY_PATH (комментарий-инструкция в
# deploy/docker-compose.yml). Стенд — HTTP, не задавать.
#OWNS3_TLS_CERT_PATH=/tls/owns3.crt
#OWNS3_TLS_KEY_PATH=/tls/owns3.key

# Peer-ключи ИСХОДЯЩИЕ узлов mesh-профиля (owns3-m1/m2): compose интерполирует
# ВЕСЬ файл — `:?`-обязательные переменные роняют любой `up` даже без профиля
# owns3-mesh (грабля — docs/adminpanel/05-dev-stand.md). Dev-значения — как в
# стенде; на приёмнике их знает access-пул его neighbors-seed (§5 G/§2).
OWNS3_MESH_PEER1_ACCESSKEY=os3m-peer-1
OWNS3_MESH_PEER1_SECRETKEY=os3m-peer-1-secret
OWNS3_MESH_PEER2_ACCESSKEY=os3m-peer-2
OWNS3_MESH_PEER2_SECRETKEY=os3m-peer-2-secret

# S3Worker (arch/24): оркестратор кластеров S3-хранилища бэкапов. Bucket
# per-install обязателен (fail-fast старта); портовой ряд API 8086/8089
# (продолжение pg/kfw/vwk). Креды клиентской грани кластеров — per-cluster
# в etcd (/s3/clusters/<C>/secrets): генерирует S3Worker, в git/env не
# попадают. Env несёт один секрет — спец-ключ бэкапа etcd (опция ниже).
S3W_BUCKET=pgworker-backups
S3W_ETCD_ENDPOINT_0=http://host.docker.internal:2379
S3W_ETCD_ENDPOINT_1=http://host.docker.internal:2381
S3W_ETCD_ENDPOINT_2=http://host.docker.internal:2383
#S3W_API_HOST_PORT=8086
#S3W_API_HOST_PORT2=8089
#S3W_ADVERTISED_HOST=host.docker.internal
#S3W_API_ENABLE_SEED=false
# Спец-ключ бэкапа etcd (arch/23 §6, arch/24 §1.1) — единственный секрет
# S3Worker вне etcd: per-install env-пара, подставляется в secrets-ключ
# etcd-backup кластера именем «backups». Обязательна ТОЛЬКО при создании
# etcd-backup кластера (без пары воркер ответит 422); полупара — fail-fast
# старта воркера.
#S3W_ETCD_BACKUP_ACCESSKEY=
#S3W_ETCD_BACKUP_SECRETKEY=

# Mesh-репликация ownS3 (t35, arch/owns3/07): пул 2–5 серверов, full-mesh
# active-active. Без соседей (пусто ниже) — репликация неактивна, поведение
# байт-в-байт как single. Состав mesh — env ТОЛЬКО seed первого старта:
# источник истины — targets.json на томе (.owns3.sys/replication/), изменение
# состава без даунтайма — PUT /admin/replication/targets (глава 07 §2).
# Peer-ключи (policy=replication) добавляются в OWNS3_ACCESS_KEYS__*.
#OWNS3_REPLICATION_TARGETS__0__NAME=mesh-node-2
#OWNS3_REPLICATION_TARGETS__0__ENDPOINT=http://mesh-node-2:9000
# ВАЖНО: у каждого соседа — СВОИ accessKey/secretKey (accessKey — идентификатор
# источника на приёмнике: дедуп (источник, seqNo) при общих кредах гасит события
# второго отправителя). Креды соседа N = его ИСХОДЯЩИЙ peer-ключ (policy=replication).
#OWNS3_REPLICATION_TARGETS__0__ACCESSKEY=os3m-peer-2
#OWNS3_REPLICATION_TARGETS__0__SECRETKEY=os3m-peer-2-secret
#OWNS3_REPLICATION_TARGETS__1__NAME=mesh-node-3
#OWNS3_REPLICATION_TARGETS__1__ENDPOINT=http://mesh-node-3:9000
#OWNS3_REPLICATION_TARGETS__1__ACCESSKEY=os3m-peer-3
#OWNS3_REPLICATION_TARGETS__1__SECRETKEY=os3m-peer-3-secret
# Bounded-бюджет журнала доставки (байт; превышение — алерт + принудительный
# тримминг, запись клиента не отказывает — глава 07 §4).
#OWNS3_REPLICATION_OUTBOX_BUDGET_BYTES=2147483648
# Окно in-flight notifier'а (события; backpressure по неприёму — глава 07 §8).
#OWNS3_REPLICATION_INFLIGHT_WINDOW=64
# Параллелизм фетчей на источник; троттлинг байт/с (0 — безлимит; глава 07 §7).
#OWNS3_REPLICATION_PARALLELISM=1
#OWNS3_REPLICATION_MAX_RATE_BYTES=0
# Потолок эксп-бэкоффа notifier/фетчера (сек).
#OWNS3_REPLICATION_BACKOFF_MAX_SEC=60
# Watermark свободного места фетчей (байт; ниже — пауза, глава 07 §7).
#OWNS3_REPLICATION_DISK_FREE_MIN_BYTES=1073741824
# Retention tombstones (часы; окно защиты от воскрешения) и период reconcile (секунды).
#OWNS3_REPLICATION_TOMBSTONE_RETENTION_HOURS=168
#OWNS3_REPLICATION_RECONCILE_INTERVAL_SECONDS=60
# Ёмкость fetch-очереди на источник (переполнение → 429 backpressure).
#OWNS3_REPLICATION_FETCH_QUEUE_MAX=10000
