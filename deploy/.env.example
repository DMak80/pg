# Секреты установки PgWorker (arch/14 Д7): per-install, в git НЕ попадают
# (deploy/.env в .gitignore). Для локального dev-стенда скопируй и меняй:
#   cp deploy/.env.example deploy/.env
# 00-up.sh делает это сам, если файла нет (dev-значения ниже).
PGW_PG_SUPERUSER_PASSWORD=pgw-local-superuser
PGW_PG_STANDBY_PASSWORD=pgw-local-standby
PGW_BUCKET_ADMIN_PASSWORD=pgw-local-bucket-admin
PGW_BUCKET_MOVER_PASSWORD=pgw-local-bucket-mover

# etcd pg-стенда (dev-stand/compose.yaml): из контейнера воркера — через хост
# (extra_hosts local:host-gateway; порт 2379 на хосте публикует pgw-stand-etcd).
PGW_ETCD_ENDPOINT=http://host.docker.internal:2379

# Advertised-имя docker-хоста в portalloc/dsn (advertised-правило arch/16,
# симметрия KFW_ADVERTISED_CLIENT_HOST): адреса нод в etcd резолвимы клиентами
# (панель пробирует host.docker.internal:15xxx/18xxx). Пусто (прод/мульти-хост,
# имена хостов резолвимы сами) → имя docker-хоста как есть.
PGW_ADVERTISED_HOST=host.docker.internal

# HTTP API воркеров (arch/14 §1.1 / arch/16 §1.1): AdvertiseUrl публикуется
# lease-ключом /pgworker/api/<id> (/kafkaworker/api/<id>) — панель резолвит
# API воркеров только по нему. Стендовые значения: pgw — хост-публикация 8080,
# kfw — 8081. ПРОД: сид выключить (false).
PGW_API_ADVERTISE_URL=http://host.docker.internal:8080
PGW_API_KEY=
PGW_API_ENABLE_SEED=true
# KafkaWorker — mTLS-only (t03, arch/16 §1.1): AdvertiseUrl https://;
# per-install TLS-пакет генерируется `bash deploy/tls/gen.sh` (ca.pem,
# server.crt/key, panel.crt/key, healthcheck.crt/key — вне git). Стендовый
# 00-up.sh сам генерирует пакет и наполняет volume kfw-api-tls; панель
# получает panel.crt/key + ca.pem через env KFW_PANEL_TLS_*_PATH.
KFW_API_ADVERTISE_URL=https://host.docker.internal:8081
KFW_API_ENABLE_SEED=true
