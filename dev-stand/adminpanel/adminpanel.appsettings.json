// Конфиг докерной панели стенда (монтируется как appsettings.Stand.json,
// ASPNETCORE_ENVIRONMENT=Stand): env-провайдер .NET не умеет задавать ключи
// словаря с "__" (HostMap__s1a__8008 развалится на вложенные секции) — HostMap
// только через JSON. Patroni-REST :8008 слушает эмулятор hc*, а conn_url ноды
// несёт имя PG-ноды (arch/02 §6.1): перекладываем на compose-имена эмуляторов.
// SQL-хосты (s1a:5432) резолвятся сетью стенда напрямую, без маппинга.
// adopt-repair: после усыновления панель берёт host:patroni из portalloc
// (ServiceParser) — там local:80xx (сайдкарные 8008 эмуляторов с хоста);
// дополнительно маппим их на compose-имена hc*.
{
  "AdminPanel": {
    "Probes": {
      "HostMap": {
        "s1a__8008": "hc1a:8008",
        "s1b__8008": "hc1b:8008",
        "s2a__8008": "hc2a:8008",
        "s2b__8008": "hc2b:8008",
        "local__8011": "hc1a:8008",
        "local__8012": "hc1b:8008",
        "local__8021": "hc2a:8008",
        "local__8022": "hc2b:8008"
      }
    }
  }
}
