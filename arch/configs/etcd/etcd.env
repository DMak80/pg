# configs/etcd/etcd.env
#
# ЭТОТ ФАЙЛ — пример для pg1. На pg2/pg3 меняется ТОЛЬКО NODE_NAME и NODE_IP.
# PEERS, CLUSTER_TOKEN, DATA_DIR, ETCD_IMAGE — ОДИНАКОВЫЕ на всех нодах.
#
# ⚠️ INITIAL_CLUSTER_STATE=new используется ТОЛЬКО при первом старте кластера.
#    После успешного формирования — переведи в existing (см. 04-deploy-etcd.md, раздел 5):
#    sed -i 's/^INITIAL_CLUSTER_STATE=new/INITIAL_CLUSTER_STATE=existing/' etcd.env

# === Под эту ноду (меняется на каждой) ===
NODE_NAME=pg1
NODE_IP=10.0.0.11

# === Образ ===
ETCD_IMAGE=quay.io/coreos/etcd:v3.5.21

# === Кластер (одинаковые на всех нодах) ===
# уникальный токен — защищает от случайного слияния с другим etcd-кластером
CLUSTER_TOKEN=pgcluster-etcd-token-2026
# полный список участников кластера: name=peer_url,name=peer_url,...
PEERS=pg1=http://10.0.0.11:2380,pg2=http://10.0.0.12:2380,pg3=http://10.0.0.13:2380

# === Данные ===
DATA_DIR=/data/etcd

# === Bootstrap ===
INITIAL_CLUSTER_STATE=new
