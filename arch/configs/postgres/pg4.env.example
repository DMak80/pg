# configs/postgres/pg4.env.example
#
# Конфиг для ЧЕТВЁРТОЙ ноды PostgreSQL (pg4) — в 4-нодовой схеме (см. 10-four-nodes.md).
# Это та же конфигурация, что и configs/postgres/pg.env, с одним важным отличием:
# SPILO_CONFIGURATION включает 2 синхронные реплики (ANY 2), чтобы при потере 2 нод
# из 4 сохранялась нулевая потеря данных.
#
# ⚠️ Это env для pg4. На pg1/pg2/pg3 положи ТОТ ЖЕ самый файл (с тем же
#    SPILO_CONFIGURATION) — настройки кластера должны быть одинаковыми на всех нодах.
#    Имя ноды Patroni берёт из `hostname` контейнера (в docker-compose.yml), НЕ из env.
#
# ⚠️ СЕКРЕТЫ (пароли) не коммить в git. Здесь — плейсхолдеры.

# ─────────────────────────────────────────────────────────────────────────────
# Идентификация кластера
# ─────────────────────────────────────────────────────────────────────────────
# Одинаковое на ВСЕХ нодах. Под него Patroni создаёт ключи в etcd.
SCOPE=pgcluster

# ─────────────────────────────────────────────────────────────────────────────
# Подключение к DCS — etcd3 (всегда 3 узла, даже в 4-нодовой схеме!)
# ─────────────────────────────────────────────────────────────────────────────
ETCD_HOSTS=pg1:2379,pg2:2379,pg3:2379

# ─────────────────────────────────────────────────────────────────────────────
# Учётные данные PostgreSQL (задаются ТОЛЬКО при bootstrap — при первом старте кластера)
# ─────────────────────────────────────────────────────────────────────────────
PGUSER_SUPERUSER=postgres
PGPASSWORD_SUPERUSER=ChangeMe_superuser_strong_password

PGUSER_STANDBY=standby
PGPASSWORD_STANDBY=ChangeMe_replication_strong_password

# ─────────────────────────────────────────────────────────────────────────────
# Пути / WAL
# ─────────────────────────────────────────────────────────────────────────────
PGROOT=/home/postgres/pgroot
USE_DATA_DIR_FOR_WAL=true

# ─────────────────────────────────────────────────────────────────────────────
# SSL / доступ
# ─────────────────────────────────────────────────────────────────────────────
ALLOW_NOSSL=true

# ─────────────────────────────────────────────────────────────────────────────
# Patroni-конфигурация: 2 СИНХРОННЫЕ реплики (отличие 4-нодовой схемы)
# ─────────────────────────────────────────────────────────────────────────────
# Ключевая разница с базовым pg.env — добавлен synchronous_standby_names: 'ANY 2 (...)'
# Это требует подтверждения от 2 реплик перед коммитом → при потере 2 нод из 4
# кластер всё ещё имеет лидера + синхронную реплику = нулевая потеря данных.
#
# NB: synchronous_standby_names применяется к лидеру. Список имён (pg2,pg3,pg4) —
# это имена нод в DCS (= hostname контейнеров). Если лидер становится pg2, Patroni
# автоматически выберет 2 других из списка для синхронизации.
SPILO_CONFIGURATION='---
bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 20
    synchronous_mode: true
    synchronous_mode_strict: false
    postgresql:
      use_pg_rewind: true
      parameters:
        max_connections: "200"
        shared_buffers: "2GB"
        effective_cache_size: "6GB"
        wal_level: replica
        hot_standby: "on"
        max_wal_senders: "10"
        max_replication_slots: "10"
        wal_keep_size: "2048MB"
        checkpoint_timeout: "15min"
        checkpoint_completion_target: "0.9"
        random_page_cost: "1.1"
        # ★ 2 синхронные реплики из кандидатного списка (quorum-based)
        # ANY 2 = «хотя бы 2 из перечисленных», порядок не важен.
        synchronous_standby_names: "ANY 2 (pg2,pg3,pg4)"
        logging_collector: "on"
        log_directory: "log"
        log_filename: "postgresql-%Y-%m-%d.log"
        log_rotation_age: "1d"
        log_rotation_size: "100MB"
postgresql:
  bin_dir: /usr/lib/postgresql/16/bin
  use_unix_socket: true
'
