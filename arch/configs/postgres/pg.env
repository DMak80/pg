# configs/postgres/pg.env
#
# Пример для pg1. На pg2/pg3 — ВСЁ ИДЕНТИЧНО (имя ноды Patroni берёт из `hostname`
# контейнера, который задаётся в docker-compose.yml, а не из этого файла).
#
# ⚠️ СЕКРЕТЫ (пароли) не коммить в git. Храни в vault / sealed-secrets / .env из
#    генератора паролей. Здесь — плейсхолдеры.

# ─────────────────────────────────────────────────────────────────────────────
# Идентификация кластера
# ─────────────────────────────────────────────────────────────────────────────
# Имя кластера (scope). ОДИНАКОВОЕ на всех нодах. Под него Patroni создаёт ключи в etcd:
#   /service/<SCOPE>/leader, /config, /members/<name>, ...
SCOPE=pgcluster

# ─────────────────────────────────────────────────────────────────────────────
# Подключение к DCS — etcd3
# ─────────────────────────────────────────────────────────────────────────────
# Список всех узлов etcd (через запятую). Spilo сам подставит в Patroni.
ETCD_HOSTS=pg1:2379,pg2:2379,pg3:2379

# ─────────────────────────────────────────────────────────────────────────────
# Учётные данные PostgreSQL (задаются ТОЛЬКО при bootstrap)
# ─────────────────────────────────────────────────────────────────────────────
# Суперпользователь
PGUSER_SUPERUSER=postgres
PGPASSWORD_SUPERUSER=ChangeMe_superuser_strong_password

# Пользователь физической репликации (создаётся на лидере, реплики подключаются по нему)
PGUSER_STANDBY=standby
PGPASSWORD_STANDBY=ChangeMe_replication_strong_password

# ─────────────────────────────────────────────────────────────────────────────
# Пути / WAL
# ─────────────────────────────────────────────────────────────────────────────
# PGROOT внутри контейнера (сюда смонтирован внешний том /data/pg хоста)
PGROOT=/home/postgres/pgroot
# Держать WAL внутри PGDATA/data/ — удобнее для бэкапа/мониторинга
USE_DATA_DIR_FOR_WAL=true

# ─────────────────────────────────────────────────────────────────────────────
# SSL / доступ
# ─────────────────────────────────────────────────────────────────────────────
# true = разрешить non-SSL соединения (для теста). В прод поставь false и настрой сертификаты.
ALLOW_NOSSL=true

# ─────────────────────────────────────────────────────────────────────────────
# Patroni-конфигурация (тонкая настройка через YAML-строку)
# ─────────────────────────────────────────────────────────────────────────────
# SPILO_CONFIGURATION встраивается в генерируемый Patroni config.
# Здесь — fail-safe базовая настройка: synchronous_mode, разумные параметры PG,
# тайминги Patroni. Полный список полей — https://patroni.readthedocs.io/en/latest/SETTINGS.html
#
# ВАЖНО про ключи:
#   synchronous_mode: true        → лидер ждёт подтверждения реплики перед коммитом
#                                   (нулевая потеря данных при failover, цена — latency)
#   loop_wait / ttl / retry_timeout → как часто Patroni опрашивает DCS и TTL lease лидера.
SPILO_CONFIGURATION='---
bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 20
    synchronous_mode: true
    synchronous_mode_strict: false
    postgresql:
      use_pg_rewind: true
      parameters:
        max_connections: "200"
        shared_buffers: "2GB"
        effective_cache_size: "6GB"
        wal_level: replica
        hot_standby: "on"
        max_wal_senders: "10"
        max_replication_slots: "10"
        wal_keep_size: "2048MB"
        checkpoint_timeout: "15min"
        checkpoint_completion_target: "0.9"
        random_page_cost: "1.1"
        logging_collector: "on"
        log_directory: "log"
        log_filename: "postgresql-%Y-%m-%d.log"
        log_rotation_age: "1d"
        log_rotation_size: "100MB"
postgresql:
  bin_dir: /usr/lib/postgresql/16/bin
  use_unix_socket: true
'
