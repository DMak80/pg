# configs/buckets/buckets.env.example
#
# Конфиг скриптов бакетного шардирования: init-cluster.sh, add-shard.sh,
# remove-shard.sh, create-bucket.sh, move-bucket.sh, abort-move.sh.
# Скопируй в buckets.env (рядом) и заполни адресами своего стенда/прода.
# Файл содержит пароли → держи chmod 600 и не коммить.
#
# Один etcd обслуживает несколько независимых кластеров: состояние каждого —
# под своим префиксом /clusters/<CLUSTER_NAME>/. Шарды и их строки подключения
# (БЕЗ паролей) регистрирует init-cluster.sh / add-shard.sh; здесь — только
# кластер по умолчанию, адреса etcd, роли и ПАРОЛИ (в etcd паролей нет).
# См. arch/11-bucket-sharding.md (§2, «Жизненный цикл системы»).

# ── Кластер (шардированная система) ───────────────────────────────────────────
# Дефолт для --cluster у всех скриптов. Константы кластера (число бакетов N,
# имя БД) фиксирует init-cluster.sh и хранит в etcd /clusters/<C>/config.
CLUSTER_NAME="shop"

# ── etcd-контрол-плейн (12-bucket-pitfalls.md, «Референс топологии») ──────────
# Ключи кластера: /clusters/<C>/config, /clusters/<C>/shards/<X>/{dsn,replicas,
# master}, /clusters/<C>/buckets/{routing,status}/<bucket>. Нет статус-ключа =
# ACTIVE. Patroni каждого шарда живёт отдельно в /service/<scope>/.
ETCD_ENDPOINTS="http://10.0.0.3:2379,http://10.0.0.4:2379,http://10.0.0.5:2379"
# Таймаут etcdctl-команд, сек:
ETCD_TIMEOUT_SEC=5

# ── Пароли шардов (сами DSN — в etcd, пароли НЕ в etcd) ───────────────────────
# Канонический DSN шарда (user=<админ-роль>) пишет init/add-shard в
# /clusters/<C>/shards/<X>/dsn; при подключениях скрипты добавляют password=
# из этих переменных. Пусто/отсутствует — если аутентификация не нужна.
#SHARD_shard1_PASSWORD="CHANGE_ME"
#SHARD_shard2_PASSWORD="CHANGE_ME"
# Роль подписок переездов и её пароль (user в DSN заменяется на MOVER_USER_<X>):
#MOVER_USER_shard1="bucket_mover"
#MOVER_PASSWORD_shard1="CHANGE_ME"
#MOVER_USER_shard2="bucket_mover"
#MOVER_PASSWORD_shard2="CHANGE_ME"

# ── App-роль (P1/P5) ──────────────────────────────────────────────────────────
# Роль приложения (≠ owner схем). Ей init-cluster/create-bucket выдаёт базовые
# гранты, заморозка P1 на cutover их ОТНИМАЕТ, abort/rollback — возвращает.
APP_ROLE="app"
# Возвращать ли app-роли CREATE ON SCHEMA при снятии моратория P5:
# 1 — да (если роль имела такое право до переезда), 0 — нет.
APP_GRANT_CREATE=0

# ── P8: синхронная фиксация применённых транзакций ────────────────────────────
# Подписки переездов создаются с synchronous_commit=<это значение> (remote_apply):
# коммит применённой транзакции ждёт, пока реплика приёмника её проиграет, —
# feedback (confirmed_flush) не убегает вперёд физической репликации приёмника,
# и failover приёмника посреди SYNCING не может молча пропустить срез изменений.
# Требование: у мастера приёмника настроен synchronous_standby_names и есть
# живая реплика (preflight move это проверяет и отказывает без неё).
SUB_SYNCCOMMIT="remote_apply"

# ── Отмена переезда (abort-move.sh, P7) ──────────────────────────────────────
# Отказывать в abort, если статус переезда обновлён свежее N сек назад —
# защита от убийства живого mover (осознанно ломается --force).
ABORT_MIN_AGE_SEC=120

# ── Legacy-режим (кластеры до введения /clusters/<C>/) ────────────────────────
# Если шарда нет в etcd-реестре кластера, скрипты берут DSN отсюда. Для новых
# кластеров используй init-cluster.sh --shard <имя>=<DSN> — эти переменные не нужны.
#SHARDS="shard1 shard2"
#SHARD_shard1_DSN="host=10.0.1.10 port=5432 dbname=app user=bucket_admin password=CHANGE_ME"
#MOVER_CONNINFO_shard1="host=10.0.1.10 port=5432 dbname=app user=bucket_mover password=CHANGE_ME"

# ── Параметры cutover (можно не трогать) ─────────────────────────────────────
# Сколько секунд ждать после установки FROZEN, прежде чем фиксировать LSN:
# это TTL кэша роутера в приложении (за это время клиенты перестают писать).
FREEZE_WAIT_SEC=5
# Таймаут lock_timeout барьера заморозки (LOCK TABLE ACCESS EXCLUSIVE) и число
# попыток: барьер упирается в живых писателей (P1).
FREEZE_LOCK_TIMEOUT=5s
FREEZE_LOCK_TRIES=3
# Сколько секунд ждать нулевой лаг в состоянии FROZEN. По таймауту cutover
# отменяется (бакет размораживается, репликация продолжает догонять).
CUTOVER_TIMEOUT_SEC=90
# Интервал опроса при ожиданиях, сек.
POLL_INTERVAL_SEC=2
# Бюджет недоступности шарда в циклах ожидания move (сек): failover приёмника
# посреди SYNCING — транзиентные обрывы, mover переживает и продолжает (P8).
CONN_FAIL_BUDGET_SEC=120
