# configs/buckets/buckets.env.example
#
# Конфиг скриптов бакетного шардирования: create-bucket.sh, move-bucket.sh.
# Скопируй в buckets.env (рядом) и заполни адресами своего стенда/прода.
# Файл содержит пароли → держи chmod 600 и не коммить.
#
# Важно: все DSN — через write-эндпоинт HAProxy соответствующего шарда (порт 5432),
# не в конкретную ноду! Иначе failover шарда рвёт и приложения, и репликацию.
# См. arch/11-bucket-sharding.md, разделы 3–4.

# ── Каталог бакетов (meta-кластер, arch/11-bucket-sharding.md §2) ────────────
# Роль должна уметь писать в таблицу buckets.
BUCKET_CATALOG_DSN="host=10.0.0.10 port=5432 dbname=meta user=bucket_admin password=CHANGE_ME"

# ── etcd-контрол-плейн v2 (12-bucket-pitfalls.md, «Референс топологии v2») ────
# Ключи: /buckets/routing/<bucket> = владелец; /buckets/status/<bucket> = JSON
# состояния переезда; нет статус-ключа = ACTIVE. Сейчас использует abort-move.sh
# (P7); переработанные на v2 скрипты переездов будут использовать шире.
ETCD_ENDPOINTS="http://10.0.0.3:2379,http://10.0.0.4:2379,http://10.0.0.5:2379"
# Таймаут etcdctl-команд, сек:
ETCD_TIMEOUT_SEC=5

# ── Отмена переезда (abort-move.sh, P7) ──────────────────────────────────────
# App-роль приложения (≠ owner схем): abort возвращает ей права после заморозки
# P1 (DML + USAGE,UPDATE на sequences). Пусто — GRANT пропускается с предупреждением.
APP_ROLE="app"
# Возвращать ли app-роли CREATE ON SCHEMA при снятии моратория P5:
# 1 — да (если роль имела такое право до переезда), 0 — нет.
APP_GRANT_CREATE=0
# Отказывать в abort, если статус переезда обновлён свежее N сек назад —
# защита от убийства живого mover (осознанно ломается --force).
ABORT_MIN_AGE_SEC=120

# ── Шарды ────────────────────────────────────────────────────────────────────
# Имена шардов: латиница/цифры/подчёркивание (используются в именах переменных
# и SQL-идентификаторах). Это те же имена, что лежат в buckets.shard_id.
SHARDS="shard1 shard2"

# DSN для psql/pg_dump с машины запуска скриптов (ops-хост):
SHARD_shard1_DSN="host=10.0.1.10 port=5432 dbname=app user=bucket_admin password=CHANGE_ME"
SHARD_shard2_DSN="host=10.0.2.10 port=5432 dbname=app user=bucket_admin password=CHANGE_ME"

# Conninfo для CREATE SUBSCRIPTION — строка, по которой шард-ПРИЁМНИК ходит на
# шард-ИСТОЧНИК (т.е. с БД-нод приёмника должен быть доступен этот адрес).
# Роль bucket_mover: атрибут REPLICATION + GRANT SELECT ON ALL TABLES IN SCHEMA.
MOVER_CONNINFO_shard1="host=10.0.1.10 port=5432 dbname=app user=bucket_mover password=CHANGE_ME"
MOVER_CONNINFO_shard2="host=10.0.2.10 port=5432 dbname=app user=bucket_mover password=CHANGE_ME"

# ── Параметры cutover (можно не трогать) ─────────────────────────────────────
# Сколько секунд ждать после установки FROZEN, прежде чем фиксировать LSN:
# это TTL кэша роутера в приложении (за это время клиенты перестают писать).
FREEZE_WAIT_SEC=5
# Сколько секунд ждать нулевой лаг в состоянии FROZEN. По таймауту cutover
# отменяется (бакет размораживается, репликация продолжает догонять).
CUTOVER_TIMEOUT_SEC=90
# Интервал опроса при ожиданиях, сек.
POLL_INTERVAL_SEC=2
# Запас для setval последовательностей при cutover (+N к max(id)).
SEQ_MARGIN=1000
