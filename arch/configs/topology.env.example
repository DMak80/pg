# configs/topology.env.example
#
# Шаблон-«заполнялка» под конкретный стенд.
# Скопируй в topology.env (или private-репо с секретами) и впиши свои значения.
# Используется скриптами в scripts/ для дефолтов.

# === Имена и IP нод ===
NODE1_HOST=pg1
NODE1_IP=10.0.0.11

NODE2_HOST=pg2
NODE2_IP=10.0.0.12

NODE3_HOST=pg3
NODE3_IP=10.0.0.13

# pg4 — ТОЛЬКО для 4-нодовой схемы (см. 10-four-nodes.md).
# В базовой 3-нодовой схеме закомментируй/удали эти строки и не задавай NODE4_*.
NODE4_HOST=pg4
NODE4_IP=10.0.0.14

LB_HOST=pg-lb
LB_IP=10.0.0.10

# === Список всех нод (для циклов в скриптах) ===
# Базовая схема (3 ноды):
# ALL_NODES="pg1 pg2 pg3"
# 4-нодовая схема:
ALL_NODES="pg1 pg2 pg3 pg4"

# === Пути к данным ===
PG_DATA_DIR=/data/pg
ETCD_DATA_DIR=/data/etcd

# === Образы ===
SPILO_IMAGE=ghcr.io/zalando/spilo-16:3.3-p3
ETCD_IMAGE=quay.io/coreos/etcd:v3.5.21
HAPROXY_IMAGE=haproxy:2.8-alpine

# === Patroni / etcd ===
SCOPE=pgcluster
ETCD_ENDPOINTS=http://pg1:2379,http://pg2:2379,http://pg3:2379
ETCD_CLIENT_TOKEN=pgcluster-etcd-token-2026

# === Учётные данные PostgreSQL (СЕКРЕТ — не коммитить!) ===
PG_SU_USER=postgres
PG_SU_PASSWORD=__CHANGE_ME__
PG_REPL_USER=standby
PG_REPL_PASSWORD=__CHANGE_ME__
