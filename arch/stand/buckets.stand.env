# arch/stand/buckets.stand.env
#
# Конфиг скриптов (arch/scripts/*.sh) для docker-стенда. Запускаются из
# ops-бокса (профиль ops в docker-compose.yml) по внутренней сети стенда:
# hap1/hap2 — write-эндпоинты шардов (выбирают текущего мастера), etcd —
# контрол-плейн. BUCKETS_ENV задаётся в docker-compose.yml.
#
# Чеки 10–70 работают в legacy-кластере (без init): шарды описаны здесь,
# бакеты создают руками/чеками. Жизненный цикл (init/add/remove-shard,
# мульти-кластерность etcd) проверяет checks/72-shard-lifecycle.sh
# в собственных кластерах (alpha/beta).

# legacy-кластер чеков 10–70 (routing/status под /clusters/legacy/)
CLUSTER_NAME="legacy"

ETCD_ENDPOINTS="http://etcd:2379"

SHARDS="s1 s2"
# DSN шардов — через их HAProxy (мастер-агностик, P2/P8: работает при failover)
SHARD_s1_DSN="host=hap1 port=5432 dbname=postgres user=postgres"
SHARD_s2_DSN="host=hap2 port=5432 dbname=postgres user=postgres"
# conninfo, по которому ДРУГОЙ шард подписывается на этот (write-эндпоинт)
MOVER_CONNINFO_s1="host=hap1 port=5432 dbname=postgres user=postgres"
MOVER_CONNINFO_s2="host=hap2 port=5432 dbname=postgres user=postgres"
# etcd-режим (кластеры alpha/beta из checks/72): user в etcd-dsn при подписках
# заменяется на MOVER_USER_<X> (стенд работает под postgres, роли bucket_mover нет)
MOVER_USER_s1="postgres"
MOVER_USER_s2="postgres"

# app-роль стенда (гранты выдаёт create-bucket.sh; заморозка P1 их отнимает)
APP_ROLE="app_role"
APP_GRANT_CREATE=1

# P8: подписки переездов — synchronous_commit=remote_apply (в compose у мастеров
# настроен synchronous_standby_names; preflight move проверяет живой sync-standby)
SUB_SYNCCOMMIT="remote_apply"

ABORT_MIN_AGE_SEC=120
