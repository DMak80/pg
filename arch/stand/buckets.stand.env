# arch/stand/buckets.stand.env
#
# Конфиг v2-скриптов (arch/scripts/abort-move.sh) для docker-стенда.
# Запускаются из ops-бокса (профиль ops в docker-compose.yml) по внутренней
# сети стенда: hap1 — write-эндпоинт шарда s1, s2 — приёмник, etcd — контрол-плейн.
# BUCKETS_ENV=/arch/stand/buckets.stand.env задаётся в docker-compose.yml.
# Каталог v1 (BUCKET_CATALOG_DSN) не нужен: abort-move.sh работает только с etcd.

ETCD_ENDPOINTS="http://etcd:2379"

SHARDS="s1 s2"
SHARD_s1_DSN="host=hap1 port=5432 dbname=postgres user=postgres"
SHARD_s2_DSN="host=s2 port=5432 dbname=postgres user=postgres"

# app-роль стенда (создаётся в checks/10-p1-p5-freeze.sh); CREATE ON SCHEMA
# у неё был до заморозки — возвращаем при abort (мораторий P5).
APP_ROLE="app_role"
APP_GRANT_CREATE=1
ABORT_MIN_AGE_SEC=120
